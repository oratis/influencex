# The OpenTelemetry auto-instrumentations suite has an unresolved peer-dep
# conflict (@opentelemetry/core 2.7 vs ^2.0 peers) that makes plain
# `npm install` / `npm ci` fail with ERESOLVE — the Dockerfile already
# passes --legacy-peer-deps for the same reason. Keep this until the OTel
# packages are upgraded in lockstep.
legacy-peer-deps=true
